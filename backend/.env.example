# Application
APP_NAME=taskbridge
APP_ENVIRONMENT=development
APP_PORT=8080

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=taskbridge
DB_PASSWORD=taskbridge
DB_NAME=taskbridge
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://taskbridge:taskbridge@rabbitmq:5672/
RABBITMQ_EXCHANGE=taskbridge.events

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
